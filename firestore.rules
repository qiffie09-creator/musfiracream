rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: public can create orders (checkout), anyone can read/update (admin panel & tracking)
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Products collection: public can read, admin updates
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Settings collection
    match /settings/{docId} {
      allow read, write: if true;
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
    
    // Media collection
    match /media/{mediaId} {
      allow read, write: if true;
    }
  }
}
