{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Musfira skincare and beauty cream products",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product display name" },
        "slug": { "type": "string", "description": "URL-friendly slug" },
        "price": { "type": "number", "description": "Price in PKR" },
        "salePrice": { "type": "number", "description": "Discounted sale price" },
        "sku": { "type": "string", "description": "SKU identifier" },
        "images": { "type": "array", "description": "Product image URLs" },
        "category": { "type": "string", "description": "Category identifier" },
        "stock": { "type": "number", "description": "Current inventory stock" },
        "stockStatus": { "type": "string", "enum": ["in_stock", "low_stock", "sold_out"] },
        "isFeatured": { "type": "boolean", "description": "Whether featured on homepage" },
        "isBestSeller": { "type": "boolean", "description": "Whether marked as best seller" },
        "rating": { "type": "number", "description": "Average star rating" },
        "reviewCount": { "type": "number", "description": "Total review count" },
        "description": { "type": "string", "description": "Full product description" },
        "shortDescription": { "type": "string", "description": "Short summary description" },
        "active": { "type": "boolean", "description": "Availability flag" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "price", "sku", "category", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Product classification category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category ID" },
        "name": { "type": "string", "description": "Category title" },
        "slug": { "type": "string", "description": "Category slug" },
        "image": { "type": "string", "description": "Cover banner image" },
        "description": { "type": "string", "description": "Category description" },
        "active": { "type": "boolean", "description": "Active visibility flag" }
      },
      "required": ["id", "name", "slug", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order tracking ID" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Pakistani phone number" },
        "email": { "type": "string", "description": "Optional customer email" },
        "address": { "type": "string", "description": "Delivery address" },
        "city": { "type": "string", "description": "Delivery city" },
        "items": { "type": "array", "description": "Purchased items list" },
        "subtotal": { "type": "number", "description": "Order subtotal in PKR" },
        "shippingFee": { "type": "number", "description": "Shipping cost in PKR" },
        "total": { "type": "number", "description": "Grand total in PKR" },
        "orderStatus": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["COD", "Online"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "phone", "address", "city", "items", "total", "orderStatus", "paymentMethod"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and before/after reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Review unique ID" },
        "productId": { "type": "string", "description": "Referenced product ID" },
        "productName": { "type": "string", "description": "Product name" },
        "reviewerName": { "type": "string", "description": "Customer name" },
        "initials": { "type": "string", "description": "Avatar initials" },
        "rating": { "type": "number", "description": "Star rating 1-5" },
        "date": { "type": "string", "description": "Formatted date" },
        "comment": { "type": "string", "description": "Review comment" },
        "beforeAfterImage": { "type": "string", "description": "Optional photo URL" },
        "verified": { "type": "boolean", "description": "Verified buyer status" }
      },
      "required": ["id", "productId", "reviewerName", "rating", "comment", "verified"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Store configuration and contact information",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "brandTagline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "supportEmail": { "type": "string" },
        "storeAddress": { "type": "string" },
        "freeShippingThreshold": { "type": "number" },
        "standardShippingFee": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Skincare product catalog documents"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer checkout orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer verified ratings and reviews"
    },
    "/settings/{docId}": {
      "schema": "SiteSettings",
      "description": "Store settings and contact configuration"
    }
  }
}
